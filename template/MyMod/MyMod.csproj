<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Rename: the DLL and .strmod get this name. -->
    <AssemblyName>MyMod</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <StratumSdk Condition="'$(StratumSdk)' == ''">$(MSBuildThisFileDirectory)..\..</StratumSdk>
  </PropertyGroup>
  <ItemGroup>
    <!-- Private=false: STRATUM provides these at runtime. -->
    <Reference Include="Stratum.API"><HintPath>$(StratumSdk)\API\Stratum.API.dll</HintPath><Private>false</Private></Reference>
    <!-- Game classes: run tools\Get-GameReferences.ps1 once, then add what you need from the refs folder, for example: -->
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(StratumSdk)\refs\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(StratumSdk)\refs\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(StratumSdk)\refs\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
